# --- ZED SDK ---
-v /usr/local/zed:/usr/local/zed
-v /usr/local/zed/resources:/usr/local/zed/resources

# --- Spinnaker SDK ---
-v /opt/spinnaker:/opt/spinnaker

# --- Device + USB access (required for both cameras) ---
-v /dev:/dev
-v /dev/bus/usb:/dev/bus/usb

# --- Norbit Sonar ---
-v /usr/local/include/norbit_fls_conversions.hpp:/usr/local/include/norbit_fls_conversions.hpp
-v /usr/local/include/norbit_fls_driver.hpp:/usr/local/include/norbit_fls_driver.hpp
-v /usr/local/include/norbit_fls_messages.hpp:/usr/local/include/norbit_fls_messages.hpp

# --- MRU
-v /usr/local/include/kongsberg_mru_driver.hpp:/usr/local/include/kongsberg_mru_driver.hpp
-v /usr/local/include/kongsberg_mru_message.hpp.hpp:/usr/local/include/kongsberg_mru_message.hpp.hpp

# --- Nortek DVL ---
-v /usr/local/include/nortek_nucleus_driver.hpp:/usr/local/include/nortek_nucleus_driver.hpp
-v /usr/local/include/nortek_nucleus_messages.hpp:/usr/local/include/nortek_nucleus_messages.hpp

# -- Environment Variables ---
--env=LD_LIBRARY_PATH=/usr/local/zed/lib:/opt/spinnaker/lib

# --- DRI render device access (required for nvvidconv / GStreamer HW encoding) ---
# GID 104 = render group on Jetson host (owns /dev/dri/renderD128, renderD129)
--group-add 104

# --- User Configurations ---
-v ~/.bashrc:/home/admin/.bashrc

# --- Realsense SDK ---
# Mount RealSense configuration file if it exists
-v ${HOME}/.realsense-config.json:/home/admin/.realsense-config.json
